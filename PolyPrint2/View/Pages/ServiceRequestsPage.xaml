<!--#region Страница сервисных заявок-->
<Page x:Class="PolyPrint2.View.Pages.ServiceRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сервисные заявки">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--#region Заголовок-->
        <TextBlock Grid.Row="0"
                   Text="Сервисные заявки"
                   Style="{StaticResource HeaderText}"/>
        <!--#endregion-->

        <!--#region Быстрые фильтры-->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal">
            <Button x:Name="FilterAllButton"
                    Content="Все"
                    Style="{StaticResource SecondaryButton}"
                    Width="100"
                    Margin="0,0,8,0"/>
            <Button x:Name="FilterNewButton"
                    Content="⚡ Новые"
                    Style="{StaticResource SecondaryButton}"
                    Width="110"
                    Margin="0,0,8,0"/>
            <Button x:Name="FilterInProgressButton"
                    Content="⚙ В работе"
                    Style="{StaticResource SecondaryButton}"
                    Width="130"
                    Margin="0,0,8,0"/>
            <Button x:Name="FilterCompletedButton"
                    Content="✓ Завершён"
                    Style="{StaticResource SecondaryButton}"
                    Width="130"
                    Margin="0,0,8,0"/>
        </StackPanel>
        <!--#endregion-->

        <!--#region Панель управления-->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Style="{StaticResource InputTextBox}"/>

            <Button x:Name="AddButton"
                    Grid.Column="2"
                    Content="➕ Добавить"
                    Style="{StaticResource SuccessButton}"
                    Width="130"/>

            <Button x:Name="EditButton"
                    Grid.Column="4"
                    Content="✎ Редактировать"
                    Style="{StaticResource PrimaryButton}"
                    Width="160"/>

            <Button x:Name="ViewWorksButton"
                    Grid.Column="6"
                    Content="📋 Работы"
                    Style="{StaticResource SecondaryButton}"
                    Width="130"/>

            <Button x:Name="DeleteButton"
                    Grid.Column="8"
                    Content="🗑 Удалить"
                    Style="{StaticResource DangerButton}"
                    Width="110"/>

            <Button x:Name="ExportButton"
                    Grid.Column="10"
                    Content="📥"
                    Style="{StaticResource SecondaryButton}"
                    Width="50"/>
        </Grid>
        <!--#endregion-->

        <!--#region Таблица заявок-->
        <DataGrid x:Name="RequestsGrid"
                  Grid.Row="6"
                  Style="{StaticResource MainDataGrid}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                  CellStyle="{StaticResource DataGridCell}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="новая">
                            <Setter Property="Background" Value="#E3F2FD"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Новая">
                            <Setter Property="Background" Value="#E3F2FD"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="в работе">
                            <Setter Property="Background" Value="#FFF8E1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="В работе">
                            <Setter Property="Background" Value="#FFF8E1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="выполнена">
                            <Setter Property="Background" Value="#E8F5E9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Выполнена">
                            <Setter Property="Background" Value="#E8F5E9"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="закрыта">
                            <Setter Property="Background" Value="#F5F5F5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Закрыта">
                            <Setter Property="Background" Value="#F5F5F5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID_Request}" Width="60"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="200"/>
                <DataGridTextColumn Header="Оборудование" Binding="{Binding EquipmentName}" Width="200"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding Created_Date, StringFormat=dd.MM.yyyy}" Width="120"/>
                <DataGridTextColumn Header="Проблема" Binding="{Binding Problem_Description}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Мастер" Binding="{Binding MasterName}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <!--#endregion-->
    </Grid>
</Page>
<!--#endregion-->
