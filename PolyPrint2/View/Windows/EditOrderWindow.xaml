<!--#region Окно редактирования заказа-->
<Window x:Class="PolyPrint2.View.Windows.EditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ"
        WindowStartupLocation="CenterScreen"
        Width="600"
        Height="500"
        ResizeMode="CanResize"
        MinWidth="500"
        MinHeight="450"
        Background="{StaticResource WindowBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!--#region Заголовок-->
        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Text="Добавление заказа"
                   Style="{StaticResource SubHeaderText}"/>
        <!--#endregion-->

        <!--#region Клиент-->
        <TextBlock Grid.Row="2"
                   Text="Клиент"
                   Style="{StaticResource LabelText}"/>
        <ComboBox x:Name="ClientComboBox"
                  Grid.Row="4"
                  Style="{StaticResource InputComboBox}"
                  DisplayMemberPath="Organization_Name"/>
        <!--#endregion-->

        <!--#region Дата заказа-->
        <TextBlock Grid.Row="6"
                   Text="Дата заказа"
                   Style="{StaticResource LabelText}"/>
        <DatePicker x:Name="OrderDatePicker"
                    Grid.Row="8"
                    Height="36"
                    FontSize="14"/>
        <!--#endregion-->

        <!--#region Статус-->
        <TextBlock Grid.Row="10"
                   Text="Статус"
                   Style="{StaticResource LabelText}"/>
        <ComboBox x:Name="StatusComboBox"
                  Grid.Row="12"
                  Style="{StaticResource InputComboBox}"/>
        <!--#endregion-->

        <!--#region Кнопки-->
        <Grid Grid.Row="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SaveButton"
                    Grid.Column="0"
                    Content="Сохранить"
                    Style="{StaticResource SuccessButton}"
                    Height="40"/>

            <Button x:Name="CancelButton"
                    Grid.Column="2"
                    Content="Отмена"
                    Style="{StaticResource SecondaryButton}"
                    Height="40"/>
        </Grid>
        <!--#endregion-->
        </Grid>
    </ScrollViewer>
</Window>
<!--#endregion-->
