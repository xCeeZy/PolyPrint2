<!--#region Окно позиций заказа-->
<Window x:Class="PolyPrint2.View.Windows.OrderItemsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Позиции заказа"
        WindowStartupLocation="CenterScreen"
        Width="850"
        Height="600"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--#region Заголовок-->
        <TextBlock Grid.Row="0"
                   Text="Позиции заказа"
                   Style="{StaticResource HeaderText}"/>
        <!--#endregion-->

        <!--#region Информация о заказе-->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="OrderInfoText"
                       Grid.Row="0"
                       Style="{StaticResource NormalText}"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="StatusText"
                       Grid.Row="2"
                       Style="{StaticResource NormalText}"/>
        </Grid>
        <!--#endregion-->

        <!--#region Список позиций-->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="EquipmentComboBox"
                          Grid.Column="0"
                          Height="36"
                          DisplayMemberPath="Name"/>

                <TextBox x:Name="QuantityBox"
                         Grid.Column="2"
                         Style="{StaticResource InputTextBox}"
                         Text="1"/>

                <Button x:Name="AddItemButton"
                        Grid.Column="4"
                        Content="Добавить позицию"
                        Style="{StaticResource SuccessButton}"
                        Width="150"
                        Height="36"/>

                <Button x:Name="DeleteItemButton"
                        Grid.Column="6"
                        Content="Удалить"
                        Style="{StaticResource DangerButton}"
                        Width="100"
                        Height="36"/>
            </Grid>

            <DataGrid x:Name="ItemsGrid"
                      Grid.Row="2"
                      Style="{StaticResource MainDataGrid}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeader}"
                      CellStyle="{StaticResource DataGridCell}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Оборудование" Binding="{Binding EquipmentName}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Цена за ед." Binding="{Binding Price, StringFormat={}{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat={}{0:N2}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!--#endregion-->

        <!--#region Итого-->
        <TextBlock x:Name="TotalText"
                   Grid.Row="6"
                   Text="Итого: 0,00 руб."
                   Style="{StaticResource NormalText}"
                   FontSize="16"
                   FontWeight="Bold"
                   HorizontalAlignment="Right"/>
        <!--#endregion-->

        <!--#region Кнопка закрытия-->
        <Button x:Name="CloseButton"
                Grid.Row="8"
                Content="Закрыть"
                Style="{StaticResource PrimaryButton}"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"/>
        <!--#endregion-->
    </Grid>
</Window>
<!--#endregion-->
